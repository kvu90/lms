DATABASE_URL=postgres://postgres:postgres@localhost:5432/lms
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-at-least-16-chars
# Optional: dedicated key material for encrypting TOTP secrets at rest
# (AES-256-GCM). When unset, the key is derived from JWT_SECRET.
MFA_ENCRYPTION_KEY=change-me-mfa-encryption-key
PORT=3000
NODE_ENV=development

# Better Auth foundation (issue #7) — disabled by default; the current
# auth system keeps handling everything while this is off. When enabling,
# BETTER_AUTH_SECRET is required (dedicated secret, NOT the JWT secret).
BETTER_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
<redacted>
BETTER_AUTH_TRUSTED_ORIGINS=

# Rate limits per IP per minute (see docs/operations-runbook.md before tightening)
RATE_LIMIT_PER_MINUTE=3000
RATE_LIMIT_AUTH_PER_MINUTE=300
# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173
