    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "catalog:",
    "supertest": "^7.3.1",
    "typescript": "catalog:nest",
    "typescript-eslint": "catalog:",
    "@eslint/js": "^10.0.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
