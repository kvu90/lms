{
  "name": "@lms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#lib/auth": "./src/lib/auth.tsx",
    "#lib/permissions": "./src/lib/permissions.tsx",
    "#test/*": "./src/test/*.ts",
    "#test/providers": "./src/test/providers.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && react-router build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "react-router dev",
    "start": "node server/prod-server.mjs",
    "start:topology": "node server/launcher.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lms/contracts": "workspace:*",
    "@lms/editor": "workspace:*",
    "@lms/ui": "workspace:*",
    "@react-router/node": "^8.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "1.7.12",
    "clsx": "^2.1.1",
    "i18next": "^26.5.4",
    "isbot": "^5",
    "katex": "^0.18.10",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0",
    "recharts": "3.8.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
