{
  "extends": "@lms/config/tsconfig/react.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lms/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@lms/ui/components/*": [
        "../../packages/ui/src/components/*.tsx"
      ],
      "@lms/ui/hooks/*": [
        "../../packages/ui/src/hooks/*.ts"
      ],
      "@lms/ui/globals.css": [
        "../../packages/ui/src/styles/globals.css"
      ]
    },
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts"
  ]
}
