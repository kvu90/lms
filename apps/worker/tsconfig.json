{
  "extends": "@lms/config/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Subpath control plane của @lms/db (issue #581 — khung định
    // tuyến phía worker đọc sổ đăng ký qua entry point này):
    // package giữ moduleResolution Node10 nên TS không đọc được
    // `exports` của package — ánh xạ thẳng tới bản dist đã build,
    // đúng cách apps/api đã làm cho cùng subpath ở issue #580.
    // Runtime Node đọc `exports` trong package.json như thường.
    "paths": {
      "@lms/db/control-plane": [
        "../../packages/db/dist/control-plane.d.ts"
      ],
      // Wildcard repository Kysely của @lms/db (chiến dịch chuyển
      // ORM sang Kysely): khai MỘT dòng duy nhất cho mọi module
      // repository về sau — cùng lý do Node10 như subpath trên.
      "@lms/db/repositories/*": [
        "../../packages/db/dist/repositories/*.d.ts"
      ],
      // Điểm vào test-support của @lms/db (harness dựng DB test):
      // chỉ test mới import, cùng cơ chế ánh xạ dist như trên.
      "@lms/db/test-support": [
        "../../packages/db/dist/test-support/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts"
  ]
}
