{
  "name": "@lms/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/i18n dist/i18n",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/i18n": "0.0.1",
    "@nestjs/schedule": "^12.0.2",
    "bullmq": "^6.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lms/config": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "catalog:",
    "typescript": "catalog:nest",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  }
}
