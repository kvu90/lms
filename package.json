{
  "name": "lms-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "heroku-postbuild": "turbo run build --filter=@lms/api --filter=@lms/worker --filter=@lms/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "seed": "pnpm --filter @lms/api build && pnpm --filter @lms/api seed:review"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
