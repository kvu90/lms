# Mẫu cấu hình cho stack production tự host bằng compose.yaml ở
# gốc repo. Sao chép thành file `.env` cùng thư mục rồi điền giá trị
# thật:  cp .env.example .env
# File `.env` chứa bí mật thật — không commit lên git (file `.env` ở
# gốc repo đã nằm trong .gitignore).
#
# Các biến có ghi "BẮT BUỘC" mà để trống thì docker compose sẽ dừng
# ngay kèm thông báo lỗi, tránh stack chạy bằng giá trị mặc định yếu.

# --- Cổng web trên máy host ---
# Service web là cửa vào duy nhất của stack; Cloudflare Tunnel (nếu
# dùng) trỏ vào cổng này.
WEB_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=postgres
# BẮT BUỘC: mật khẩu của PostgreSQL trong container (chuỗi ngẫu nhiên dài).
POSTGRES_PASSWORD=
POSTGRES_DB=lms
# BẮT BUỘC: mật khẩu của role kết nối database control plane
# (database `lms_control_plane` riêng trên cùng cụm Postgres,
# role riêng `lms_control_plane`, issue #580 — chuỗi ngẫu nhiên
# dài, khác POSTGRES_PASSWORD).
CONTROL_PLANE_POSTGRES_PASSWORD=
# BẮT BUỘC: mật khẩu của role RUNTIME `lms_runtime` (issue #586) —
# role mà api và worker dùng để kết nối kho nghiệp vụ: không phải
# superuser, không sở hữu đối tượng nào, chỉ có quyền dữ liệu tối
# thiểu. Role được cấp phát tự động ở bước migrate của stack; mật
# khẩu ở đây là nguồn sự thật duy nhất của nó (chuỗi ngẫu nhiên
# dài, khác mọi mật khẩu còn lại).
RUNTIME_POSTGRES_PASSWORD=
# BẮT BUỘC: mật khẩu của role MIGRATION `lms_migrator` (issue
# #586) — role chủ sở hữu kho nghiệp vụ, chỉ các bước áp migration
# và công cụ vận hành đội kho dùng tới; tầng ứng dụng không chạy
# bằng role này. Được cấp phát cùng lượt với role runtime.
MIGRATOR_POSTGRES_PASSWORD=
# Trần kết nối của các pool trong ngân sách kết nối của cụm
# (issue #586, tuỳ chọn — mặc định trong compose.yaml là 10 cho
# api, 10 cho worker, 4 cho control plane): tổng các trần này
# cộng phần dự phòng cho công cụ vận hành phải nằm dưới
# max_connections của PostgreSQL (mặc định 100).
#DATABASE_POOL_MAX=10
#WORKER_DATABASE_POOL_MAX=10
#CONTROL_PLANE_POOL_MAX=4
# --- Công cụ vận hành đội kho (issue #586, chỉ dùng khi vận hành
# gọi các lệnh fleet:* trên máy triển khai) ---
# Thư mục chứa bản sao lưu logic của mọi kho — PHẢI trỏ ra vùng
# lưu trữ ngoài máy cụm và được gắn vào môi trường chạy công cụ.
#FLEET_BACKUP_DIR=
# Cụm mật khẩu mã hoá các bản sao lưu (AES-256-GCM); không đặt thì
# bản sao lưu lưu ở dạng thô của pg_dump.
#FLEET_BACKUP_ENCRYPTION_KEY=

# --- Bí mật của ứng dụng ---
# BẮT BUỘC: khoá ký JWT của API, tối thiểu 32 ký tự ngẫu nhiên.
JWT_SECRET=
# BẮT BUỘC khi BETTER_AUTH_ENABLED=true: khoá bí mật của Better Auth,
# tối thiểu 32 ký tự ngẫu nhiên (khác JWT_SECRET).
BETTER_AUTH_SECRET=
# Khoá mã hoá MFA (tuỳ chọn; không đặt thì tính năng MFA bị vô hiệu an
# toàn). Chỉ bỏ dấu # ở dòng mẫu dưới khi thật sự cấu hình (tối thiểu 16
# ký tự): ứng dụng kiểm tra độ dài tối thiểu khi biến CÓ MẶT, nên một
# dòng gán rỗng chép nguyên từ mẫu này sẽ làm ứng dụng lỗi khởi động.
#MFA_ENCRYPTION_KEY=

# --- Địa chỉ công khai của hệ thống ---
# URL gốc mà trình duyệt dùng để truy cập hệ thống (qua Cloudflare
# Tunnel hoặc mạng nội bộ). BETTER_AUTH_URL và CORS_ORIGINS phải khớp
# origin này, nếu không đăng nhập và các request từ trình duyệt sẽ lỗi.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=
CORS_ORIGINS=http://localhost:8080
BETTER_AUTH_ENABLED=true
# Máy chủ uỷ quyền MCP tích hợp (endpoint /mcp) — bật như production.
MCP_AS_ENABLED=true

# --- Tài khoản quản trị khởi tạo ---
# API tự tạo tài khoản quản trị này ở lần khởi động đầu tiên khi cơ sở
# dữ liệu chưa có người dùng. Đổi mật khẩu ngay sau lần đăng nhập đầu.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@localhost

# --- Email (Resend) ---
# Không đặt cả hai biến dưới thì hệ thống chạy ở chế độ ghi log thay cho
# gửi mail thật (đăng ký/xác thực email sẽ không gửi được thư ra ngoài).
# Khi gửi thật phải đặt ĐỦ CẢ HAI; chỉ bỏ dấu # ở hai dòng mẫu khi cấu
# hình — ứng dụng kiểm tra tối thiểu 1 ký tự khi biến CÓ MẶT, nên dòng
# gán rỗng sẽ làm ứng dụng lỗi khởi động.
#RESEND_API_KEY=
#MAIL_FROM=
