node_modules/
dist/
build/
.turbo/
coverage/
.env
.env.local
*.log
.DS_Store
apps/api/drizzle/meta/*_snapshot.json.tmp

# local content-addressed file storage (dev default)
data/

# Compiled output lives only in dist/ — never next to sources:
# app-root config builds (e.g. drizzle.config.ts) and stray emit in src/test.
apps/*/*.js
apps/*/*.d.ts
apps/*/*.js.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/test/**/*.js
apps/*/test/**/*.d.ts
apps/*/test/**/*.js.map
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
# Ngoại lệ có chủ đích: file kiểu Kysely của @lms/db được kysely-codegen
# sinh từ DB thật và COMMIT vào repo tại src/types (CI kiểm lệch bằng
# cách sinh lại rồi so git diff) — chúng là nguồn, không phải bản biên
# dịch, nên phải thoát khỏi pattern *.d.ts ở trên.
!packages/db/src/types/*.d.ts
